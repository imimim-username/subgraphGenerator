# Enforce lockfile integrity and exact version pins for supply-chain safety.
#
# package-lock=true  — always write/update package-lock.json; refuse to
#                      install if --no-package-lock is passed accidentally.
# save-exact=true    — `npm install <pkg>` pins "1.2.3" not "^1.2.3",
#                      keeping new deps consistent with our pinning policy.
package-lock=true
save-exact=true
